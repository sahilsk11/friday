LIVEKIT_URL=ws://localhost:7880
# Production: keep LIVEKIT_URL/LIVEKIT_INTERNAL_URL local to the sas box and
# expose LIVEKIT_PUBLIC_URL through Cloudflare without Access.
# LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880
# LIVEKIT_PUBLIC_URL=wss://friday-livekit.ultron.sh
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=friday-local-dev-secret-32-bytes
FRIDAY_LIVEKIT_AGENT_NAME=friday

FRIDAY_API_HOST=0.0.0.0
FRIDAY_API_PORT=8000
FRIDAY_TOKEN_TTL_SECONDS=3600
FRIDAY_CORS_ORIGINS=http://localhost:5173
# Production: /home/sas/projects/friday/web/dist
FRIDAY_WEB_DIST=web/dist

ELEVEN_API_KEY=replace-me
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_LANGUAGE_CODE=en
ELEVENLABS_VAD_SILENCE_THRESHOLD_SECS=0.3
ELEVENLABS_VAD_THRESHOLD=0.4
ELEVENLABS_MIN_SPEECH_DURATION_MS=100
ELEVENLABS_MIN_SILENCE_DURATION_MS=300
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_TTS_VOICE_ID=SAz9YHcvj6GT2YYXdXww

FRIDAY_COMMIT_TRANSCRIPT_TIMEOUT_SECS=1.0
FRIDAY_COMMIT_STT_FLUSH_DURATION_SECS=0.3

FRIDAY_NARRATOR_BRAIN=openai_compatible
# OpenRouter-compatible HTTP is the default narrator LLM provider:
FRIDAY_NARRATOR_LLM_PROVIDER=openai_compatible
OPENROUTER_API_KEY=replace-me
# FRIDAY_NARRATOR_LLM_BASE_URL=https://openrouter.ai/api/v1
# FRIDAY_NARRATOR_LLM_MODEL=openai/gpt-oss-20b:free

# To use the local OpenCode server for narrator decisions instead:
# FRIDAY_NARRATOR_LLM_PROVIDER=opencode_server
# FRIDAY_NARRATOR_OPENCODE_BASE_URL=http://127.0.0.1:4096
# FRIDAY_NARRATOR_OPENCODE_MODEL=provider/model
# FRIDAY_NARRATOR_OPENCODE_AGENT=build
FRIDAY_NARRATOR_PROGRESS_INITIAL_DELAY_SECS=2.0
FRIDAY_NARRATOR_PROGRESS_COOLDOWN_SECS=6.0

# Optional. Leave unset in production so the browser uses window.location.
VITE_FRIDAY_BASE_URL=http://localhost:8000
