{
  "name": "voice-gateway-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
